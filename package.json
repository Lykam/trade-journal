{
  "name": "trade-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx build/check-dist.ts",
    "check:dist": "tsx build/check-dist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import": "tsx cli/import.ts",
    "trades": "tsx cli/trades.ts",
    "verify": "tsx cli/verify.ts",
    "quotes": "tsx build/fetch-quotes.ts",
    "quotes:cache": "tsx build/quotes-cache.ts",
    "market": "tsx build/market-open.ts",
    "pages-guard": "tsx build/pages-guard.ts",
    "encrypt": "tsx build/encrypt.ts",
    "scan": "tsx cli/scan-public.ts",
    "dev:demo": "tsx build/dev-demo.ts",
    "preview:demo": "tsx build/preview-demo.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "ajv": "^8.20.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yahoo-finance2": "^4.0.3"
  }
}
