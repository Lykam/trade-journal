{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "overrides.schema.json",
  "title": "trade-history overrides.json",
  "type": "object",
  "required": ["trades", "openingPositions"],
  "additionalProperties": false,
  "properties": {
    "trades": {
      "type": "object",
      "description": "Keyed by trade id (the id of the first fill in the trade).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "style": { "enum": ["day", "swing"] },
          "exclude": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "ideaId": { "type": "string" }
        }
      }
    },
    "openingPositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "symbol", "qty", "avgPrice", "openedAt"],
        "properties": {
          "account": { "type": "string" },
          "symbol": { "type": "string" },
          "qty": { "type": "number", "exclusiveMinimum": 0 },
          "avgPrice": { "type": "number", "minimum": 0 },
          "openedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
