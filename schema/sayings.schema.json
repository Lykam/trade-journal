{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sayings.schema.json",
  "title": "trade-history sayings.json (the QUOTES page: trading quotes worth keeping)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sayings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sayings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "addedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^q-[0-9a-f]{12}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "source": { "type": "string", "minLength": 1, "maxLength": 200 },
          "link": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000 },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
          },
          "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        }
      }
    }
  }
}
