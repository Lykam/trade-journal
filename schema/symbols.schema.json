{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "symbols.schema.json",
  "title": "trade-history symbols.json (single-stock ETF to underlying)",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["underlying", "type", "leverage", "direction"],
    "properties": {
      "underlying": { "type": "string", "minLength": 1 },
      "type": { "const": "leveraged_etf" },
      "leverage": { "type": "number", "exclusiveMinimum": 0 },
      "direction": { "enum": ["long", "inverse"] },
      "issuer": { "type": "string" }
    }
  }
}
